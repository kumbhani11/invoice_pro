<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:InvoicePro"
             x:Class="InvoicePro.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <Color x:Key="WinBgColor">#F0F0F0</Color>
        <Color x:Key="WinPanelColor">#F5F6F7</Color>
        <Color x:Key="WinBorderColor">#808080</Color>
        <Color x:Key="WinBorderLightColor">#ABABAB</Color>
        <Color x:Key="WinInputBorderColor">#7F9DB9</Color>
        <Color x:Key="WinHighlightColor">#0078D7</Color>
        <Color x:Key="WinSuccessColor">#217346</Color>
        <Color x:Key="WinDangerColor">#C42B1C</Color>
        <Color x:Key="WinMutedColor">#666666</Color>

        <SolidColorBrush x:Key="WinBg"           Color="{StaticResource WinBgColor}"/>
        <SolidColorBrush x:Key="WinPanel"         Color="{StaticResource WinPanelColor}"/>
        <SolidColorBrush x:Key="WinBorder"        Color="{StaticResource WinBorderColor}"/>
        <SolidColorBrush x:Key="WinBorderLight"   Color="{StaticResource WinBorderLightColor}"/>
        <SolidColorBrush x:Key="WinInputBorder"   Color="{StaticResource WinInputBorderColor}"/>
        <SolidColorBrush x:Key="WinHighlight"     Color="{StaticResource WinHighlightColor}"/>
        <SolidColorBrush x:Key="WinSuccess"       Color="{StaticResource WinSuccessColor}"/>
        <SolidColorBrush x:Key="WinDanger"        Color="{StaticResource WinDangerColor}"/>
        <SolidColorBrush x:Key="WinMuted"         Color="{StaticResource WinMutedColor}"/>
        <SolidColorBrush x:Key="AppTextColor">#1A1A1A</SolidColorBrush>

        <FontFamily x:Key="WinFontUI">Segoe UI, Tahoma, Arial, sans-serif</FontFamily>
        <FontFamily x:Key="WinFontMono">Consolas, Courier New, monospace</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- ── Base ── -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ── Standard Button ── -->
        <Style Selector="Button">
            <Setter Property="FontFamily"   Value="{StaticResource WinFontUI}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Height"       Value="24"/>
            <Setter Property="Padding"      Value="12,2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Background"   Value="#E1E1E1"/>
            <Setter Property="BorderBrush"  Value="{StaticResource WinBorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="#E5F1FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background"  Value="#CCE4F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
        </Style>

        <!-- ── Primary Button ── -->
        <Style Selector="Button.Primary">
            <Setter Property="Background"  Value="{StaticResource WinHighlight}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="#106EBE"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>

        <!-- ── Success Button ── -->
        <Style Selector="Button.Success">
            <Setter Property="Background"  Value="{StaticResource WinSuccess}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#1A5C38"/>
        </Style>
        <Style Selector="Button.Success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A5C38"/>
        </Style>

        <!-- ── Danger Button ── -->
        <Style Selector="Button.Danger">
            <Setter Property="Background"  Value="{StaticResource WinDanger}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#A02315"/>
        </Style>
        <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#A02315"/>
        </Style>

        <!-- ── Menu Bar Button ── -->
        <Style Selector="Button.menubar">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Padding"         Value="8,1"/>
            <Setter Property="CornerRadius"    Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style Selector="Button.menubar:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="#D0E8F8"/>
            <Setter Property="BorderBrush" Value="#7EB4EA"/>
        </Style>
        <Style Selector="Button.menubar:pressed /template/ ContentPresenter">
            <Setter Property="Background"  Value="#B8D8F0"/>
            <Setter Property="BorderBrush" Value="#569DE5"/>
        </Style>

        <!-- ── Toolbar Button ── -->
        <Style Selector="Button.toolbar">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"           Value="26"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="2"/>
            <Setter Property="CornerRadius"    Value="1"/>
            <Setter Property="FontSize"        Value="14"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="#CEE5FC"/>
            <Setter Property="BorderBrush" Value="#69A5E0"/>
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter">
            <Setter Property="Background"  Value="#B8D8F0"/>
            <Setter Property="BorderBrush" Value="#569DE5"/>
        </Style>

        <!-- ── Tab Border ── -->
        <Style Selector="Border.tab">
            <Setter Property="Background"      Value="#D8D8D8"/>
            <Setter Property="BorderBrush"     Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Margin"          Value="2,3,0,0"/>
            <Setter Property="CornerRadius"    Value="0"/>
        </Style>
        <Style Selector="Border.tab.tabActive">
            <Setter Property="Background"   Value="#F0F0F0"/>
            <Setter Property="BorderBrush"  Value="#808080"/>
            <Setter Property="Margin"       Value="2,2,0,0"/>
        </Style>

        <!-- ── Company Selection Button ── -->
        <Style Selector="Button.companyBtn">
            <Setter Property="Height"          Value="90"/>
            <Setter Property="Padding"         Value="10,20"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="BorderBrush"     Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#E6E6E6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.companyBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#EEF6FF" Offset="0"/>
                        <GradientStop Color="#CCE4F7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#0078D7"/>
        </Style>
        <Style Selector="Button.companyBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#CCE4F7" Offset="0"/>
                        <GradientStop Color="#B8D8F0" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab Button ── -->
        <Style Selector="Button.tabBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Padding"         Value="10,1"/>
            <Setter Property="CornerRadius"    Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── TextBox ── -->
        <Style Selector="TextBox">
            <Setter Property="FontFamily"      Value="{StaticResource WinFontUI}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="MinHeight"       Value="24"/>
            <Setter Property="Padding"         Value="5,3"/>
            <Setter Property="CornerRadius"    Value="0"/>
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource WinInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ── Card Border ── -->
        <Style Selector="Border.Card">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource WinBorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>

        <!-- ── DataGrid ── -->
        <Style Selector="DataGrid">
            <Setter Property="GridLinesVisibility"    Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D4D4D4"/>
            <Setter Property="VerticalGridLinesBrush"   Value="#D4D4D4"/>
            <Setter Property="RowHeight"              Value="28"/>
            <Setter Property="FontSize"               Value="12"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background"      Value="#E4E4E4"/>
            <Setter Property="BorderBrush"     Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="Height"          Value="26"/>
        </Style>
        <Style Selector="DataGridRow:nth-child(even)">
            <Setter Property="Background" Value="#F9F9F9"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{StaticResource WinHighlight}"/>
        </Style>
    </Application.Styles>
</Application>
