<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:InvoicePro"
             x:Class="InvoicePro.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Resources>
    <!-- InvoicePro design tokens -->
    <Color x:Key="WinBgColor">#F4F7FB</Color>
    <Color x:Key="WinPanelColor">#FFFFFF</Color>
    <Color x:Key="WinBorderColor">#E2E8F0</Color>
    <Color x:Key="WinBorderLightColor">#EDF1F6</Color>
    <Color x:Key="WinInputBorderColor">#CBD5E1</Color>
    <Color x:Key="WinHighlightColor">#2563EB</Color>
    <Color x:Key="WinSuccessColor">#15803D</Color>
    <Color x:Key="WinDangerColor">#DC2626</Color>
    <Color x:Key="WinWarningColor">#D97706</Color>
    <Color x:Key="WinMutedColor">#64748B</Color>
    <Color x:Key="WinTextColor">#17243A</Color>
    <Color x:Key="WinSidebarColor">#17243A</Color>
    <Color x:Key="WinSidebarHoverColor">#263B59</Color>

    <SolidColorBrush x:Key="WinBg" Color="{StaticResource WinBgColor}"/>
    <SolidColorBrush x:Key="WinPanel" Color="{StaticResource WinPanelColor}"/>
    <SolidColorBrush x:Key="WinBorder" Color="{StaticResource WinBorderColor}"/>
    <SolidColorBrush x:Key="WinBorderLight" Color="{StaticResource WinBorderLightColor}"/>
    <SolidColorBrush x:Key="WinInputBorder" Color="{StaticResource WinInputBorderColor}"/>
    <SolidColorBrush x:Key="WinHighlight" Color="{StaticResource WinHighlightColor}"/>
    <SolidColorBrush x:Key="WinSuccess" Color="{StaticResource WinSuccessColor}"/>
    <SolidColorBrush x:Key="WinDanger" Color="{StaticResource WinDangerColor}"/>
    <SolidColorBrush x:Key="WinWarning" Color="{StaticResource WinWarningColor}"/>
    <SolidColorBrush x:Key="WinMuted" Color="{StaticResource WinMutedColor}"/>
    <SolidColorBrush x:Key="AppTextColor" Color="{StaticResource WinTextColor}"/>
    <SolidColorBrush x:Key="WinSidebar" Color="{StaticResource WinSidebarColor}"/>
    <SolidColorBrush x:Key="WinSidebarHover" Color="{StaticResource WinSidebarHoverColor}"/>

    <FontFamily x:Key="WinFontUI">Segoe UI, Inter, Tahoma, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="WinFontMono">Consolas, 'Courier New', monospace</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Base typography and surfaces -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource WinBg}"/>
      <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource AppTextColor}"/>
    </Style>
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{StaticResource WinPanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinBorderLight}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.tab">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinBorder}"/>
      <Setter Property="BorderThickness" Value="1,1,1,0"/>
      <Setter Property="Margin" Value="2,3,0,0"/>
      <Setter Property="CornerRadius" Value="8,8,0,0"/>
    </Style>
    <Style Selector="Border.tab.tabActive">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinBorder}"/>
      <Setter Property="Margin" Value="2,2,0,0"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource AppTextColor}"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="#B8C5D6"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#E8EEF6"/>
      <Setter Property="BorderBrush" Value="#94A3B8"/>
    </Style>
    <Style Selector="Button.Primary">
      <Setter Property="Background" Value="{StaticResource WinHighlight}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8"/>
      <Setter Property="BorderBrush" Value="#1D4ED8"/>
    </Style>
    <Style Selector="Button.Primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E40AF"/>
      <Setter Property="BorderBrush" Value="#1E40AF"/>
    </Style>
    <Style Selector="Button.Success">
      <Setter Property="Background" Value="{StaticResource WinSuccess}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinSuccess}"/>
    </Style>
    <Style Selector="Button.Success:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#166534"/>
      <Setter Property="BorderBrush" Value="#166534"/>
    </Style>
    <Style Selector="Button.Danger">
      <Setter Property="Background" Value="{StaticResource WinDanger}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinDanger}"/>
    </Style>
    <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B91C1C"/>
      <Setter Property="BorderBrush" Value="#B91C1C"/>
    </Style>
    <Style Selector="Button.companyBtn">
      <Setter Property="MinHeight" Value="88"/>
      <Setter Property="Padding" Value="14,16"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.companyBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
    </Style>
    <Style Selector="Button.companyBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#DBEAFE"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
    </Style>
    <Style Selector="Button.tabBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1F5F9"/>
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinInputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource AppTextColor}"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
    </Style>

    <!-- Data grid: softer separators and readable rows -->
    <Style Selector="DataGrid">
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF4"/>
      <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
      <Setter Property="RowHeight" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource WinBorderLight}"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#E8EDF4"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style Selector="DataGridRow:nth-child(even)">
      <Setter Property="Background" Value="#FCFDFE"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#DBEAFE"/>
    </Style>
  </Application.Styles>
</Application>