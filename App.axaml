<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InvoicePro.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <!-- Windows Classic Color Palette -->
        <Color x:Key="WinBgColor">#F0F0F0</Color>
        <Color x:Key="WinPanelColor">#F5F6F7</Color>
        <Color x:Key="WinBorderColor">#808080</Color>
        <Color x:Key="WinBorderLightColor">#ABABAB</Color>
        <Color x:Key="WinInputBorderColor">#7F9DB9</Color>
        <Color x:Key="WinHighlightColor">#0078D7</Color>
        
        <SolidColorBrush x:Key="WinBg" Color="{StaticResource WinBgColor}"/>
        <SolidColorBrush x:Key="WinPanel" Color="{StaticResource WinPanelColor}"/>
        <SolidColorBrush x:Key="WinBorder" Color="{StaticResource WinBorderColor}"/>
        <SolidColorBrush x:Key="WinBorderLight" Color="{StaticResource WinBorderLightColor}"/>
        <SolidColorBrush x:Key="WinInputBorder" Color="{StaticResource WinInputBorderColor}"/>
        <SolidColorBrush x:Key="WinHighlight" Color="{StaticResource WinHighlightColor}"/>

        <!-- Typography -->
        <FontFamily x:Key="WinFontUI">Segoe UI, Tahoma, Arial, sans-serif</FontFamily>
        <FontFamily x:Key="WinFontMono">Consolas, Courier New, monospace</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Global Base Overrides -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- WinForms/Notepad++ Style Button -->
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinBorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E5F1FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#CCE4F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinHighlight}"/>
        </Style>

        <!-- WinForms Classic TextBox -->
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource WinFontUI}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Toolbar Button Style -->
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#CEE5FC"/>
            <Setter Property="BorderBrush" Value="#69A5E0"/>
        </Style>

        <!-- TabControl: Rectangular Classic Tabs -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="0,0,-1,0"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinBorderLight}"/>
            <Setter Property="Background" Value="#E1E1E1"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource WinBorder}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Classic Compact DataGrid Gridlines & Cells -->
        <Style Selector="DataGrid">
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D4D4D4"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D4D4D4"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#E4E4E4"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="DataGridRow:nth-child(even)">
            <Setter Property="Background" Value="#F9F9F9"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{StaticResource WinHighlight}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Application.Styles>
</Application>