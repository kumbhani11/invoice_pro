<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Settings"
             x:DataType="vm:SettingsViewModel"
             x:Class="InvoicePro.UI.Settings.SettingsView"
             Background="{StaticResource WinBg}">

    <Grid RowDefinitions="Auto, *">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="💾 Save Settings" Command="{Binding SaveSettingsCommand}" Classes="Success"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource WinSuccess}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource WinBorderLight}"
                    BorderThickness="1" Padding="16" Width="520" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="These details appear on printed invoices."
                               FontSize="11" Foreground="{StaticResource WinMuted}" Margin="0,0,0,8"/>

                    <TextBlock Text="Company Name *" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CurrentCompany.Name}"/>

                    <TextBlock Text="GSTIN / Tax ID" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.GSTIN}"/>

                    <TextBlock Text="Phone" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.Phone}"/>

                    <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.Email}"/>

                    <TextBlock Text="Registered Office Address" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.RegisteredOffice}"
                             Height="52" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Text="Sales Office Address" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.SalesOffice}"
                             Height="52" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Text="State" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.State}"/>

                    <TextBlock Text="State Code" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.StateCode}"/>

                    <TextBlock Text="Terms &amp; Conditions" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding CurrentCompany.TermsAndConditions}"
                             Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="e.g. Goods once sold will not be taken back."/>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
