<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Dashboard"
             x:DataType="vm:DashboardViewModel"
             x:Class="InvoicePro.UI.Dashboard.DashboardView"
             Background="{StaticResource WinBg}">

    <Grid RowDefinitions="Auto, *">

        <!-- Section Header -->
        <Border Grid.Row="0" Background="{StaticResource WinHighlight}" Padding="10,6">
            <TextBlock Text="InvoicePro — Commercial Billing System"
                       FontSize="13" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Launcher Grid -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel Spacing="16">

                <!-- Quick Actions Group -->
                <StackPanel Spacing="4">
                    <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource WinMuted}" Margin="0,0,0,4"/>
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource WinBorderLight}"
                            BorderThickness="1" Padding="8">
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding NewBillCommand}"    Width="120" Height="72" Margin="4" Background="Transparent" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="New Invoice" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AllBillsCommand}"   Width="120" Height="72" Margin="4" Background="Transparent" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="🗂" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="All Invoices" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CustomersCommand}"  Width="120" Height="72" Margin="4" Background="Transparent" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="👥" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Customers" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ProductsCommand}"   Width="120" Height="72" Margin="4" Background="Transparent" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Products" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReportsCommand}"    Width="120" Height="72" Margin="4" Background="Transparent" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Reports" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SettingsCommand}"   Width="120" Height="72" Margin="4" Background="Transparent" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="⚙" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Settings" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BackupCommand}"     Width="120" Height="72" Margin="4" Background="Transparent" BorderThickness="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="💾" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Backup" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <!-- Info Panel -->
                <Border Background="#FFFFFF" BorderBrush="{StaticResource WinBorderLight}"
                        BorderThickness="1" Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="COMPANY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WinMuted}"/>
                        <TextBlock Text="{Binding CompanyDisplayName}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
