<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Customers"
             x:DataType="vm:CustomersViewModel"
             x:Class="InvoicePro.UI.Customers.CustomersView"
             Background="{StaticResource WinBg}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="+ Add Customer" Command="{Binding AddNewCommand}" Classes="Primary"/>
                <Rectangle Width="1" Height="16" Fill="#C0C0C0" Margin="2,0"/>
                <TextBlock Text="Search:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SearchText}" Watermark="Name, GSTIN, phone…" Width="220"/>
            </StackPanel>
        </Border>

        <!-- List + Edit Pane -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding CustomersList}"
                      SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"   Binding="{Binding Name}"   Width="*"/>
                    <DataGridTextColumn Header="GSTIN"  Binding="{Binding GSTIN}"  Width="150"/>
                    <DataGridTextColumn Header="Phone"  Binding="{Binding Phone}"  Width="120"/>
                    <DataGridTextColumn Header="State"  Binding="{Binding State}"  Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Edit Form -->
            <Border Grid.Column="1" Background="#FFFFFF"
                    BorderBrush="{StaticResource WinBorderLight}" BorderThickness="1,0,0,0"
                    Width="280" Padding="10,8"
                    IsVisible="{Binding IsEditing}">
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Customer Details" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="Name *"/>
                        <TextBox Text="{Binding CurrentCustomer.Name}"/>

                        <TextBlock Text="GSTIN" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding CurrentCustomer.GSTIN}"/>

                        <TextBlock Text="Phone" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding CurrentCustomer.Phone}"/>

                        <TextBlock Text="Address" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding CurrentCustomer.Address}"
                                 Height="52" AcceptsReturn="True" TextWrapping="Wrap"/>

                        <TextBlock Text="State" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding CurrentCustomer.State}"/>

                        <TextBlock Text="State Code" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding CurrentCustomer.StateCode}"/>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}"/>
                            <Button Content="Save"   Command="{Binding SaveAsyncCommand}" Classes="Success"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="2" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,1,0,0"
                Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="✏ Edit"
                        Command="{Binding EditSelectedCommand}" Classes="Primary"
                        IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="🗑 Delete"
                        Command="{Binding DeleteSelectedCommand}" Classes="Danger"
                        IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
