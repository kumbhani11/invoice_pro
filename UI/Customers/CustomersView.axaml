<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Customers"
             x:DataType="vm:CustomersViewModel"
             x:Class="InvoicePro.UI.Customers.CustomersView">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header & Top Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Text="CUSTOMERS" Classes="PageTitle"/>
            
            <TextBox Grid.Column="2" Text="{Binding SearchText}" Watermark="Search Customer..." Width="250" Margin="20,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                <Button Content="+ ADD CUSTOMER" Command="{Binding AddNewCommand}" Classes="Primary" VerticalAlignment="Center"/>
                <Button Content="BACK TO DASHBOARD" Command="{Binding GoToDashboardCommand}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <!-- DataGrid -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding CustomersList}" SelectedItem="{Binding SelectedCustomer}" 
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource AppBorderColor}" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding GSTIN}"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Edit/Add Form Pane -->
            <Border Grid.Column="1" Classes="Card" Width="350" Margin="20,0,0,0"
                    IsVisible="{Binding IsEditing}">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Customer Details" FontSize="20" FontWeight="Bold"/>
                        
                        <TextBlock Text="Name *"/>
                        <TextBox Text="{Binding CurrentCustomer.Name}"/>
                        
                        <TextBlock Text="GSTIN"/>
                        <TextBox Text="{Binding CurrentCustomer.GSTIN}"/>
                        
                        <TextBlock Text="Phone"/>
                        <TextBox Text="{Binding CurrentCustomer.Phone}"/>
                        
                        <TextBlock Text="Address"/>
                        <TextBox Text="{Binding CurrentCustomer.Address}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                        
                        <TextBlock Text="State"/>
                        <TextBox Text="{Binding CurrentCustomer.State}"/>
                        
                        <TextBlock Text="State Code"/>
                        <TextBox Text="{Binding CurrentCustomer.StateCode}"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Command="{Binding CancelEditCommand}"/>
                            <Button Content="SAVE" Command="{Binding SaveAsyncCommand}" Classes="Success"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Actions Panel for Selected Item -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
            <Button Content="EDIT" Command="{Binding EditSelectedCommand}" Classes="Primary" IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Content="DELETE" Command="{Binding DeleteSelectedCommand}" Classes="Danger" IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>
    </Grid>
</UserControl>
