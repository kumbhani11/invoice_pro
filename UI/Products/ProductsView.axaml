<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Products"
             x:DataType="vm:ProductsViewModel"
             x:Class="InvoicePro.UI.Products.ProductsView">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header & Top Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Text="PRODUCTS" Classes="PageTitle"/>
            
            <TextBox Grid.Column="2" Text="{Binding SearchText}" Watermark="Search Product..." Width="250" Margin="20,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                <Button Content="+ ADD PRODUCT" Command="{Binding AddNewCommand}" Classes="Primary" VerticalAlignment="Center"/>
                <Button Content="BACK TO DASHBOARD" Command="{Binding GoToDashboardCommand}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <!-- DataGrid -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding ProductsList}" SelectedItem="{Binding SelectedProduct}" 
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource AppBorderColor}" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="HSN/SAC" Binding="{Binding HSNCode}"/>
                    <DataGridTextColumn Header="Rate (₹)" Binding="{Binding Rate}"/>
                    <DataGridTextColumn Header="GST (%)" Binding="{Binding TaxPercentage}"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Edit/Add Form Pane -->
            <Border Grid.Column="1" Classes="Card" Width="350" Margin="20,0,0,0"
                    IsVisible="{Binding IsEditing}">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Product Details" FontSize="20" FontWeight="Bold"/>
                        
                        <TextBlock Text="Product Code *"/>
                        <TextBox Text="{Binding CurrentProduct.ProductCode}"/>
                        
                        <TextBlock Text="Description *"/>
                        <TextBox Text="{Binding CurrentProduct.Description}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                        
                        <TextBlock Text="HSN / SAC Code"/>
                        <TextBox Text="{Binding CurrentProduct.HSNCode}"/>
                        
                        <TextBlock Text="Rate (₹) *"/>
                        <NumericUpDown Value="{Binding CurrentProduct.Rate}" Minimum="0" FormatString="0.00"/>
                        
                        <TextBlock Text="GST Percentage (%)"/>
                        <NumericUpDown Value="{Binding CurrentProduct.TaxPercentage}" Minimum="0" Maximum="100" FormatString="0"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Command="{Binding CancelEditCommand}"/>
                            <Button Content="SAVE" Command="{Binding SaveAsyncCommand}" Classes="Success"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Actions Panel for Selected Item -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
            <Button Content="EDIT" Command="{Binding EditSelectedCommand}" Classes="Primary" IsEnabled="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Content="DELETE" Command="{Binding DeleteSelectedCommand}" Classes="Danger" IsEnabled="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>
    </Grid>
</UserControl>
