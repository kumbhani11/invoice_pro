<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Products"
             x:DataType="vm:ProductsViewModel"
             x:Class="InvoicePro.UI.Products.ProductsView"
             Background="{StaticResource WinBg}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="+ Add Product" Command="{Binding AddNewCommand}" Classes="Primary"/>
                <Rectangle Width="1" Height="16" Fill="#C0C0C0" Margin="2,0"/>
                <TextBlock Text="Search:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SearchText}" Watermark="Code or description…" Width="220"/>
            </StackPanel>
        </Border>

        <!-- List + Edit Pane -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding ProductsList}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code"        Binding="{Binding ProductCode}"  Width="110" FontFamily="{StaticResource WinFontMono}"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}"  Width="*"/>
                    <DataGridTextColumn Header="HSN/SAC"     Binding="{Binding HSNCode}"      Width="90"  FontFamily="{StaticResource WinFontMono}"/>
                    <DataGridTextColumn Header="Rate (₹)"   Binding="{Binding Rate}"          Width="90"  FontFamily="{StaticResource WinFontMono}"/>
                    <DataGridTextColumn Header="GST %"       Binding="{Binding TaxPercentage}" Width="70"  FontFamily="{StaticResource WinFontMono}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Edit Form -->
            <Border Grid.Column="1" Background="#FFFFFF"
                    BorderBrush="{StaticResource WinBorderLight}" BorderThickness="1,0,0,0"
                    Width="280" Padding="10,8"
                    IsVisible="{Binding IsEditing}">
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Product Details" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Text="Product Code *"/>
                        <TextBox Text="{Binding CurrentProduct.ProductCode}"/>

                        <TextBlock Text="Description *" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding CurrentProduct.Description}"
                                 Height="52" AcceptsReturn="True" TextWrapping="Wrap"/>

                        <TextBlock Text="HSN / SAC Code" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding CurrentProduct.HSN}"/>

                        <TextBlock Text="Rate (₹) *" Margin="0,4,0,0"/>
                        <NumericUpDown Value="{Binding CurrentProduct.Rate}" Minimum="0" FormatString="0.00"/>

                        <TextBlock Text="GST %" Margin="0,4,0,0"/>
                        <NumericUpDown Value="{Binding CurrentProduct.TaxPercentage}" Minimum="0" Maximum="100" FormatString="0"/>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}"/>
                            <Button Content="Save"   Command="{Binding SaveAsyncCommand}" Classes="Success"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="2" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,1,0,0"
                Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="✏ Edit"
                        Command="{Binding EditSelectedCommand}" Classes="Primary"
                        IsEnabled="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="🗑 Delete"
                        Command="{Binding DeleteSelectedCommand}" Classes="Danger"
                        IsEnabled="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
