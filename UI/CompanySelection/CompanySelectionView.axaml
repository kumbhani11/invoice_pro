<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InvoicePro.UI.CompanySelection"
        x:DataType="vm:CompanySelectionViewModel"
        x:Class="InvoicePro.UI.CompanySelection.CompanySelectionView"
        Title="Billing Software - Startup"
        Width="520"
        MinHeight="260"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#F3F6FA"
        FontSize="12">

    <Grid>
        <StackPanel Margin="22,18" Spacing="16">
            <TextBlock Text="Choose your company profile" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
            <TextBlock Text="Select a company to open its billing data and invoice setup." FontSize="13" Foreground="#475569" TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,12,*">
                <Button Grid.Column="0"
                        Command="{Binding OpenAvaniCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Classes="companyBtn"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="🏢" FontSize="28" Foreground="#2563EB" HorizontalAlignment="Center"/>
                        <TextBlock Text="AVANI ENTERPRISE" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding OpenHardikaCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Classes="companyBtn"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="🏭" FontSize="28" Foreground="#2563EB" HorizontalAlignment="Center"/>
                        <TextBlock Text="HARDIKA CREATION" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Border IsVisible="{Binding IsLoading}" Background="#66000000">
            <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="12" Width="300" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="10"/>
                    <TextBlock Text="{Binding LoadingMessage}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#111827"/>
                    <TextBlock Text="Please wait while the company data loads." FontSize="12" Foreground="#475569" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
