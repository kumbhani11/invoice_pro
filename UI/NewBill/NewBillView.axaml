<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.NewBill"
             xmlns:models="using:InvoicePro.Models"
             x:DataType="vm:NewBillViewModel"
             x:Class="InvoicePro.UI.NewBill.NewBillView">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        
        <!-- Header: Customer & Date -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *, Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Select Customer" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" HorizontalAlignment="Stretch" PlaceholderText="Select Customer or Cash...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Customer">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Grid.Column="1">
                <TextBlock Text="Invoice Date" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding InvoiceDate}" HorizontalAlignment="Stretch"/>
            </StackPanel>
            
            <Button Grid.Column="2" Content="BACK TO DASHBOARD" Command="{Binding GoToDashboardCommand}" VerticalAlignment="Bottom" Margin="20,0,0,0"/>
        </Grid>

        <!-- Product Entry -->
        <Border Grid.Row="1" Classes="Card" Margin="0,0,0,15" Padding="15">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Product" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" HorizontalAlignment="Stretch" PlaceholderText="Search Product...">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <TextBlock>
                                    <Run Text="{Binding ProductCode}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Quantity" FontWeight="Bold"/>
                    <NumericUpDown Value="{Binding Quantity}" Minimum="1" FormatString="0" Width="100"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="ADD ITEM" Command="{Binding AddItemCommand}" Classes="Primary" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Bill Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding InvoiceItems}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource AppBorderColor}" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}"/>
                <DataGridTemplateColumn Header="Action">
                    <DataTemplate x:DataType="models:InvoiceItem">
                        <Button Content="Remove" Command="{Binding $parent[UserControl].((vm:NewBillViewModel)DataContext).RemoveItemCommand}" CommandParameter="{Binding .}" Classes="Danger"/>
                    </DataTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals & Save -->
        <Grid Grid.Row="3" ColumnDefinitions="*, 350" Margin="0,20,0,0">
            <!-- Save Button Area -->
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                <Button Content="SAVE INVOICE" Command="{Binding SaveInvoiceCommand}" Classes="Success" FontSize="20" Padding="30,15"/>
            </StackPanel>
            
            <!-- Totals Area -->
            <Border Grid.Column="1" Classes="Card" Padding="15">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gross Amount:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GrossAmount}"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount:"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DiscountAmount}" Minimum="0" FormatString="0.00" Width="100" Margin="0,5"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Taxable Amount:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxableAmount}"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CGST (9%):" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CgstAmount}" Margin="0,5,0,0"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="SGST (9%):"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SgstAmount}"/>
                    
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Round Off:"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RoundOff}"/>
                    
                    <Rectangle Grid.Row="6" Grid.ColumnSpan="2" Height="1" Fill="{DynamicResource AppBorderColor}" Margin="0,10"/>
                    
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="NET AMOUNT:" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding NetAmount}" FontWeight="Bold" FontSize="18"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
