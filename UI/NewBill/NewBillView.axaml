<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.NewBill"
             x:DataType="vm:NewBillViewModel"
             x:Class="InvoicePro.UI.NewBill.NewBillView">

  <UserControl.Styles>
    <Style Selector="Border.sec">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#CBD3DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="Border.sec-hdr">
      <Setter Property="Background" Value="#EDF1F6"/>
      <Setter Property="BorderBrush" Value="#CBD3DF"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Height" Value="26"/>
    </Style>
    <Style Selector="TextBlock.hdr-lbl">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#17243B"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#536176"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.inp">
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderBrush" Value="#C6D1E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#17243B"/>
    </Style>
    <Style Selector="TextBox.inp:focus">
      <Setter Property="BorderBrush" Value="#1769E8"/>
    </Style>
    <Style Selector="ComboBox.inp">
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderBrush" Value="#C6D1E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.btn-primary">
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="#1769E8"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#1769E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F55C5"/>
      <Setter Property="BorderBrush" Value="#0F55C5"/>
    </Style>
    <Style Selector="Button.btn-primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#A0B8E8"/>
      <Setter Property="BorderBrush" Value="#A0B8E8"/>
    </Style>
    <Style Selector="Button.btn-print">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="#1769E8"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#1769E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn-print:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F55C5"/>
      <Setter Property="BorderBrush" Value="#0F55C5"/>
    </Style>
    <Style Selector="Button.btn-print:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#A0B8E8"/>
      <Setter Property="BorderBrush" Value="#A0B8E8"/>
    </Style>
    <Style Selector="Button.btn-ghost">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#17243B"/>
      <Setter Property="BorderBrush" Value="#CBD3DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.btn-icon">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#536176"/>
      <Setter Property="BorderBrush" Value="#C6D1E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn-del">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#D93025"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn-del:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FDECEA"/>
    </Style>
    <Style Selector="DataGrid#ItemsGrid">
      <Setter Property="GridLinesVisibility" Value="All"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#CBD3DF"/>
      <Setter Property="VerticalGridLinesBrush" Value="#CBD3DF"/>
      <Setter Property="RowHeight" Value="24"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="DataGrid#ItemsGrid DataGridColumnHeader">
      <Setter Property="Background" Value="#EDF1F6"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#17243B"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="BorderBrush" Value="#CBD3DF"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style Selector="DataGrid#ItemsGrid DataGridRow:nth-child(even)">
      <Setter Property="Background" Value="#F7F9FC"/>
    </Style>
    <Style Selector="DataGrid#ItemsGrid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#E8F1FF"/>
    </Style>
  </UserControl.Styles>

  <!--
    Outer DockPanel: status bar docked to Bottom (always visible),
    ScrollViewer fills the rest (fallback scroll for small windows).
  -->
  <DockPanel Background="#F3F5F8">

    <!-- STATUS BAR — docked bottom, always visible -->
    <Border DockPanel.Dock="Bottom"
            Background="#FFFFFF" BorderBrush="#CBD3DF" BorderThickness="0,1,0,0"
            Padding="10,0" Height="36">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Ready"
                   FontSize="12" Foreground="#536176" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding CompanyName}"
                   FontSize="12" FontWeight="Bold" Foreground="#17243B"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Name="SwitchCompanyBtn" Content="Switch"
                Classes="btn-ghost" Margin="0,0,10,0"
                AutomationProperties.Name="Switch Company"/>
        <TextBlock Grid.Column="3"
                   Text="Printing automatically saves the invoice."
                   FontSize="11" Foreground="#536176" VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <Button Grid.Column="4" Classes="btn-print"
                Command="{Binding PrintCommand}"
                IsEnabled="{Binding !IsPrinting}"
                AutomationProperties.Name="Print Invoice">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Path Data="M6 2h8v3H6zM4 5h12a2 2 0 0 1 2 2v5H2V7a2 2 0 0 1 2-2zM2 13h16v5H2z"
                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform"
                  VerticalAlignment="Center"/>
            <TextBlock Text="Print" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- SCROLLABLE CONTENT -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <!--
        Root Grid: 7 rows
        Row 0 = Title header          Auto
        Row 1 = Company | Invoice     Auto  MaxHeight~125
        Row 2 = BillTo  | SupplyTo    Auto  MaxHeight~150
        Row 3 = Products | Summary    *     MinHeight=260
        Row 4 = Amount in words       Auto
        Row 5 = Footer                Auto  MaxHeight~100
        Row 6 = spacer                8px
      -->
      <Grid Margin="12,12,12,4"
            RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,8">

        <!-- ═══ ROW 0: TITLE ═══ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="0,0,0,6">
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="TAX INVOICE" FontSize="22" FontWeight="Bold"
                       Foreground="#17243B" HorizontalAlignment="Center"/>
            <TextBlock Text="GST TAX INVOICE" FontSize="11" Foreground="#536176"
                       HorizontalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="Original for Recipient"
                     FontSize="12" Foreground="#536176"
                     HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>


        <!-- ═══ ROW 1: Company Information | Invoice Details ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,6" MaxHeight="130">

          <!-- Company Information -->
          <Border Grid.Column="0" Classes="sec" Margin="0,0,3,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <TextBlock Text="Company Information" Classes="hdr-lbl"/>
              </Border>
              <StackPanel Grid.Row="1" Margin="10,6,10,6" Spacing="2">
                <TextBlock Text="{Binding CompanyName}" FontSize="20" FontWeight="Bold"
                           Foreground="#17243B" TextWrapping="NoWrap"/>
                <Grid ColumnDefinitions="95,8,*">
                  <TextBlock Grid.Column="0" Text="Regd. Office" FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding CompanyAddress1}" FontSize="11"
                             Foreground="#536176" TextWrapping="Wrap"/>
                </Grid>
                <Grid ColumnDefinitions="95,8,*">
                  <TextBlock Grid.Column="0" Text="Sales Office" FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding CompanyAddress2}" FontSize="11"
                             Foreground="#536176" TextWrapping="Wrap"/>
                </Grid>
                <Grid ColumnDefinitions="95,8,*">
                  <TextBlock Grid.Column="0" Text="Ph." FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding CompanyPhone}" FontSize="11"
                             Foreground="#536176"/>
                </Grid>
                <Grid ColumnDefinitions="95,8,*">
                  <TextBlock Grid.Column="0" Text="GSTIN" FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding CompanyGstin}" FontSize="12"
                             FontWeight="Bold" Foreground="#17243B"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Invoice Details -->
          <Border Grid.Column="1" Classes="sec" Margin="3,0,0,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <TextBlock Text="Invoice Details" Classes="hdr-lbl"/>
              </Border>
              <StackPanel Grid.Row="1" Margin="10,6,10,6" Spacing="5">
                <Grid ColumnDefinitions="100,*">
                  <TextBlock Grid.Column="0" Text="Invoice No." Classes="lbl"
                             FontWeight="SemiBold" TextAlignment="Right"/>
                  <TextBox Grid.Column="1" Classes="inp" Margin="6,0,0,0"
                           Text="{Binding InvoiceNumber, Mode=TwoWay}"
                           AutomationProperties.Name="Invoice Number"/>
                </Grid>
                <Grid ColumnDefinitions="100,*">
                  <TextBlock Grid.Column="0" Text="Date" Classes="lbl"
                             FontWeight="SemiBold" TextAlignment="Right"/>
                  <Grid Grid.Column="1" ColumnDefinitions="*,28" Margin="6,0,0,0">
                    <TextBox Grid.Column="0" Classes="inp"
                             Text="{Binding InvoiceDateString, Mode=TwoWay}"
                             AutomationProperties.Name="Invoice Date"/>
                    <Button Grid.Column="1" Classes="btn-icon" Content="📅"
                            FontSize="12" Margin="2,0,0,0" ToolTip.Tip="Pick date"/>
                  </Grid>
                </Grid>
                <Grid ColumnDefinitions="100,*">
                  <TextBlock Grid.Column="0" Text="State" Classes="lbl"
                             FontWeight="SemiBold" TextAlignment="Right"/>
                  <TextBox Grid.Column="1" Classes="inp" Margin="6,0,0,0"
                           Text="{Binding InvoiceState, Mode=TwoWay}"
                           AutomationProperties.Name="Invoice State"/>
                </Grid>
                <Grid ColumnDefinitions="100,*">
                  <TextBlock Grid.Column="0" Text="State Code" Classes="lbl"
                             FontWeight="SemiBold" TextAlignment="Right"/>
                  <TextBox Grid.Column="1" Classes="inp" Width="120"
                           HorizontalAlignment="Left" Margin="6,0,0,0"
                           Text="{Binding InvoiceStateCode, Mode=TwoWay}"
                           AutomationProperties.Name="Invoice State Code"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

        </Grid>


        <!-- ═══ ROW 2: Bill To Party | Supply To Party ═══ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,6" MaxHeight="155">

          <!-- Bill To Party -->
          <Border Grid.Column="0" Classes="sec" Margin="0,0,3,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <TextBlock Text="Bill To Party" Classes="hdr-lbl"/>
              </Border>
              <StackPanel Grid.Row="1" Margin="10,6,10,6" Spacing="5">
                <Grid ColumnDefinitions="95,*,30">
                  <TextBlock Grid.Column="0" Text="Customer" Classes="lbl"/>
                  <ComboBox Grid.Column="1" Classes="inp" HorizontalAlignment="Stretch"
                            Margin="6,0,0,0"
                            ItemsSource="{Binding Customers}"
                            SelectedItem="{Binding SelectedCustomer}"
                            AutomationProperties.Name="Bill To Customer">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding CustomerName}" FontSize="12"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Classes="btn-icon" Content="🔍"
                          Margin="4,0,0,0" ToolTip.Tip="Search customer"
                          AutomationProperties.Name="Search Customer"/>
                </Grid>
                <Grid ColumnDefinitions="95,*">
                  <TextBlock Grid.Column="0" Text="Address" Classes="lbl"
                             VerticalAlignment="Top" Margin="0,3,0,0"/>
                  <TextBox Grid.Column="1" Classes="inp" Margin="6,0,0,0"
                           MinHeight="42" Height="42"
                           Text="{Binding BillToAddress, Mode=TwoWay}"
                           TextWrapping="Wrap" AcceptsReturn="False"
                           AutomationProperties.Name="Bill To Address"/>
                </Grid>
                <Grid ColumnDefinitions="95,*">
                  <TextBlock Grid.Column="0" Text="GSTIN" Classes="lbl"/>
                  <TextBox Grid.Column="1" Classes="inp" Margin="6,0,0,0"
                           Width="200" HorizontalAlignment="Left"
                           Text="{Binding BillToGstin, Mode=TwoWay}"
                           AutomationProperties.Name="Bill To GSTIN"/>
                </Grid>
                <Grid ColumnDefinitions="95,*,Auto,76">
                  <TextBlock Grid.Column="0" Text="State" Classes="lbl"/>
                  <TextBox Grid.Column="1" Classes="inp" Margin="6,0,0,0"
                           Text="{Binding BillToState, Mode=TwoWay}"
                           AutomationProperties.Name="Bill To State"/>
                  <TextBlock Grid.Column="2" Text="State Code" FontSize="11"
                             Foreground="#536176" VerticalAlignment="Center" Margin="6,0,4,0"/>
                  <TextBox Grid.Column="3" Classes="inp"
                           Text="{Binding BillToStateCode, Mode=TwoWay}"
                           AutomationProperties.Name="Bill To State Code"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Supply To Party -->
          <Border Grid.Column="1" Classes="sec" Margin="3,0,0,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Supply To Party" Classes="hdr-lbl"/>
                  <CheckBox Grid.Column="1" Content="Same as Bill To Party"
                            IsChecked="{Binding UseSameCustomer, Mode=TwoWay}"
                            FontSize="11" Foreground="#536176"
                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1" Margin="10,6,10,6" Spacing="5">
                <Grid ColumnDefinitions="95,*,30">
                  <TextBlock Grid.Column="0" Text="Customer" Classes="lbl"/>
                  <ComboBox Grid.Column="1" Classes="inp" HorizontalAlignment="Stretch"
                            Margin="6,0,0,0"
                            IsEnabled="{Binding !UseSameCustomer}"
                            ItemsSource="{Binding Customers}"
                            SelectedItem="{Binding SupplyToCustomer}"
                            AutomationProperties.Name="Supply To Customer">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding CustomerName}" FontSize="12"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Classes="btn-icon" Content="🔍"
                          IsEnabled="{Binding !UseSameCustomer}"
                          Margin="4,0,0,0" ToolTip.Tip="Search customer"
                          AutomationProperties.Name="Search Supply Customer"/>
                </Grid>
                <Grid ColumnDefinitions="95,*">
                  <TextBlock Grid.Column="0" Text="Address" Classes="lbl"
                             VerticalAlignment="Top" Margin="0,3,0,0"/>
                  <TextBox Grid.Column="1" Margin="6,0,0,0"
                           MinHeight="42" Height="42"
                           Text="{Binding SupplyToAddress, Mode=TwoWay}"
                           TextWrapping="Wrap" AcceptsReturn="False"
                           IsReadOnly="{Binding UseSameCustomer}"
                           Classes="inp"
                           AutomationProperties.Name="Supply To Address"/>
                </Grid>
                <Grid ColumnDefinitions="95,*">
                  <TextBlock Grid.Column="0" Text="GSTIN" Classes="lbl"/>
                  <TextBox Grid.Column="1" Margin="6,0,0,0"
                           Width="200" HorizontalAlignment="Left"
                           Text="{Binding SupplyToGstin, Mode=TwoWay}"
                           IsReadOnly="{Binding UseSameCustomer}"
                           Classes="inp"
                           AutomationProperties.Name="Supply To GSTIN"/>
                </Grid>
                <Grid ColumnDefinitions="95,*,Auto,76">
                  <TextBlock Grid.Column="0" Text="State" Classes="lbl"/>
                  <TextBox Grid.Column="1" Margin="6,0,0,0"
                           Text="{Binding SupplyToState, Mode=TwoWay}"
                           IsReadOnly="{Binding UseSameCustomer}"
                           Classes="inp"
                           AutomationProperties.Name="Supply To State"/>
                  <TextBlock Grid.Column="2" Text="State Code" FontSize="11"
                             Foreground="#536176" VerticalAlignment="Center" Margin="6,0,4,0"/>
                  <TextBox Grid.Column="3"
                           Text="{Binding SupplyToStateCode, Mode=TwoWay}"
                           IsReadOnly="{Binding UseSameCustomer}"
                           Classes="inp"
                           AutomationProperties.Name="Supply To State Code"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

        </Grid>


        <!-- ═══ ROW 3: Product Details (3*) | Summary+GST (1*) ═══ -->
        <Grid Grid.Row="3" ColumnDefinitions="3*,1*" MinHeight="260" Margin="0,0,0,6">

          <!-- Product Details -->
          <Border Grid.Column="0" Classes="sec" Margin="0,0,3,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="Product Details" Classes="hdr-lbl"/>
                  <Button Grid.Column="1" Content="+ Add Item" Classes="btn-primary"
                          Command="{Binding AddRowCommand}"
                          Height="22" FontSize="11" Padding="8,0"
                          Margin="0,0,6,0"
                          AutomationProperties.Name="Add Item"/>
                  <Button Grid.Column="2" Classes="btn-del" Content="🗑"
                          Command="{Binding RemoveRowCommand}"
                          Width="22" Height="22"
                          ToolTip.Tip="Remove last row"
                          AutomationProperties.Name="Remove Last Row"/>
                </Grid>
              </Border>

              <DataGrid Grid.Row="1" Name="ItemsGrid"
                        ItemsSource="{Binding InvoiceItems}"
                        AutoGenerateColumns="False"
                        HeadersVisibility="Column"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="False"
                        CanUserSortColumns="False"
                        SelectionMode="Single"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>

                  <DataGridTemplateColumn Header="S.No" Width="0.5*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding SNo}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Product Description" Width="4*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ProductDescription}" FontSize="12"
                                   Margin="4,0" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding ProductDescription, Mode=TwoWay}"
                                 FontSize="12" Margin="2" BorderThickness="0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="FIT" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Fit}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Fit, Mode=TwoWay}"
                                 FontSize="12" Margin="2" BorderThickness="0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="SIZE" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Size}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Size, Mode=TwoWay}"
                                 FontSize="12" Margin="2" BorderThickness="0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="HSN" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Hsn}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Hsn, Mode=TwoWay}"
                                 FontSize="12" Margin="2" BorderThickness="0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="QTY" Width="0.8*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Qty}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Qty, Mode=TwoWay}"
                                 FontSize="12" Margin="2" BorderThickness="0"
                                 HorizontalContentAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="UOM" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Uom}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <ComboBox SelectedItem="{Binding Uom, Mode=TwoWay}"
                                  FontSize="12" Margin="1" Height="26">
                          <ComboBoxItem>Pcs</ComboBoxItem>
                          <ComboBoxItem>Mtr</ComboBoxItem>
                          <ComboBoxItem>Kg</ComboBoxItem>
                          <ComboBoxItem>Box</ComboBoxItem>
                          <ComboBoxItem>Set</ComboBoxItem>
                        </ComboBox>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Rate (₹)" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Rate, StringFormat={}{0:F2}}" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Rate, Mode=TwoWay}"
                                 FontSize="12" Margin="2" BorderThickness="0"
                                 HorizontalContentAlignment="Right"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Amount (₹)" Width="1.4*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Amount, StringFormat={}{0:F2}}" FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="" Width="0.6*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Classes="btn-del"
                                Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="🗑"
                                ToolTip.Tip="Delete row"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.Name="Delete Row"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <!-- Right Panel: Invoice Summary + GST Breakdown -->
          <Border Grid.Column="1" Classes="sec" Margin="3,0,0,0">
            <Grid RowDefinitions="28,Auto,28,Auto">

              <Border Grid.Row="0" Classes="sec-hdr">
                <TextBlock Text="Invoice Summary" Classes="hdr-lbl"/>
              </Border>

              <StackPanel Grid.Row="1" Margin="10,8,10,6" Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Total Qty" FontSize="12" Foreground="#536176"/>
                  <TextBlock Grid.Column="1" Text="{Binding TotalQuantity}"
                             FontSize="12" FontWeight="SemiBold" Foreground="#17243B"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Subtotal (₹)" FontSize="12" Foreground="#536176"/>
                  <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat={}{0:F2}}"
                             FontSize="12" Foreground="#17243B"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Discount" FontSize="12" Foreground="#536176"
                             VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Classes="inp" Width="80" Height="26"
                           Text="{Binding DiscountAmount, Mode=TwoWay, StringFormat={}{0:F2}}"
                           HorizontalContentAlignment="Right" FontSize="12"
                           AutomationProperties.Name="Discount Amount"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Taxable Amt (₹)" FontSize="12" Foreground="#536176"/>
                  <TextBlock Grid.Column="1" Text="{Binding TaxableAmount, StringFormat={}{0:F2}}"
                             FontSize="12" Foreground="#17243B"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding PreviewGstLabel}" FontSize="12" Foreground="#536176"/>
                  <TextBlock Grid.Column="1" Text="{Binding TaxTotal, StringFormat={}{0:F2}}"
                             FontSize="12" Foreground="#17243B"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Round Off" FontSize="12" Foreground="#536176"/>
                  <TextBlock Grid.Column="1" Text="{Binding RoundOffAmount, StringFormat={}{0:F2}}"
                             FontSize="12" Foreground="#17243B"/>
                </Grid>
                <Border Background="#E8F1FF" CornerRadius="3" Padding="8,5" Margin="0,2,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="NET AMOUNT (₹)"
                               FontSize="12" FontWeight="Bold" Foreground="#17243B"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:F2}}"
                               FontSize="18" FontWeight="Bold" Foreground="#17243B"/>
                  </Grid>
                </Border>
              </StackPanel>

              <Border Grid.Row="2" Classes="sec-hdr">
                <TextBlock Text="GST Breakdown" Classes="hdr-lbl"/>
              </Border>

              <Grid Grid.Row="3" Margin="10,8,10,6" RowDefinitions="Auto,Auto,Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,50,70">
                  <TextBlock Grid.Column="0" Text="Tax Head" FontSize="11"
                             FontWeight="Bold" Foreground="#536176"/>
                  <TextBlock Grid.Column="1" Text="%" FontSize="11"
                             FontWeight="Bold" Foreground="#536176" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Amount (₹)" FontSize="11"
                             FontWeight="Bold" Foreground="#536176" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,50,70" Margin="0,4,0,0">
                  <TextBlock Grid.Column="0" Text="CGST" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text="{Binding PreviewCgstRate}" FontSize="12"
                             Foreground="#17243B" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding CgstAmount, StringFormat={}{0:F2}}"
                             FontSize="12" Foreground="#17243B" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,50,70" Margin="0,3,0,0">
                  <TextBlock Grid.Column="0" Text="SGST" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text="{Binding PreviewSgstRate}" FontSize="12"
                             Foreground="#17243B" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding SgstAmount, StringFormat={}{0:F2}}"
                             FontSize="12" Foreground="#17243B" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,50,70" Margin="0,3,0,0">
                  <TextBlock Grid.Column="0" Text="IGST" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text="{Binding PreviewIgstRate}" FontSize="12"
                             Foreground="#17243B" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding PreviewIgstAmount}" FontSize="12"
                             Foreground="#17243B" HorizontalAlignment="Right"/>
                </Grid>
              </Grid>

            </Grid>
          </Border>

        </Grid>

        <!-- ═══ ROW 4: Amount in Words ═══ -->
        <Border Grid.Row="4" Classes="sec" Margin="0,0,0,6">
          <Grid ColumnDefinitions="Auto,*" Margin="10,5">
            <TextBlock Grid.Column="0" Text="Rupees in words :"
                       FontSize="12" FontWeight="Bold" Foreground="#17243B"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Classes="inp" IsReadOnly="True"
                     Text="{Binding PreviewAmountInWords}"
                     Background="#F7F9FC" BorderThickness="0"
                     AutomationProperties.Name="Amount in Words"/>
          </Grid>
        </Border>

        <!-- ═══ ROW 5: Footer 4* / 4* / 3* ═══ -->
        <Grid Grid.Row="5" ColumnDefinitions="4*,4*,3*" MaxHeight="105">

          <!-- Bank Details -->
          <Border Grid.Column="0" Classes="sec" Margin="0,0,3,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <TextBlock Text="Bank Details" Classes="hdr-lbl"/>
              </Border>
              <StackPanel Grid.Row="1" Margin="10,6,10,6" Spacing="3">
                <Grid ColumnDefinitions="72,8,*">
                  <TextBlock Grid.Column="0" Text="Bank Name" FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding SelectedCompany.BankName}"
                             FontSize="12" Foreground="#536176" TextWrapping="Wrap"/>
                </Grid>
                <Grid ColumnDefinitions="72,8,*">
                  <TextBlock Grid.Column="0" Text="Branch" FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding SelectedCompany.BankBranch}"
                             FontSize="12" Foreground="#536176" TextWrapping="Wrap"/>
                </Grid>
                <Grid ColumnDefinitions="72,8,*">
                  <TextBlock Grid.Column="0" Text="Bank A/C" FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding SelectedCompany.BankAccountNo}"
                             FontSize="12" Foreground="#536176"/>
                </Grid>
                <Grid ColumnDefinitions="72,8,*">
                  <TextBlock Grid.Column="0" Text="Bank IFSC" FontSize="12"
                             FontWeight="SemiBold" Foreground="#17243B"/>
                  <TextBlock Grid.Column="1" Text=":" FontSize="12" Foreground="#17243B"/>
                  <TextBlock Grid.Column="2" Text="{Binding SelectedCompany.BankIFSC}"
                             FontSize="12" Foreground="#536176"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Terms and Conditions -->
          <Border Grid.Column="1" Classes="sec" Margin="3,0,3,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <TextBlock Text="Terms &amp; Conditions" Classes="hdr-lbl"/>
              </Border>
              <StackPanel Grid.Row="1" Margin="10,6,10,6" Spacing="3">
                <TextBlock Text="1. Goods once sold will not be taken back."
                           FontSize="11" Foreground="#536176" TextWrapping="Wrap"/>
                <TextBlock Text="2. Interest @ 18% p.a. will be charged after due date."
                           FontSize="11" Foreground="#536176" TextWrapping="Wrap"/>
                <TextBlock Text="3. Subject to local jurisdiction."
                           FontSize="11" Foreground="#536176" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Authorised Signatory -->
          <Border Grid.Column="2" Classes="sec" Margin="3,0,0,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Classes="sec-hdr">
                <TextBlock Text="Authorised Signatory" Classes="hdr-lbl"/>
              </Border>
              <StackPanel Grid.Row="1" Margin="10,4,10,4" Spacing="2"
                          HorizontalAlignment="Center">
                <TextBlock Text="Certified that the particulars given above are true and correct."
                           FontSize="10" Foreground="#536176" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding CompanyName, StringFormat='For {0}'}"
                           FontSize="12" FontWeight="Bold" Foreground="#17243B"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Border BorderBrush="#CBD3DF" BorderThickness="0,0,0,1"
                        Width="150" Margin="0,18,0,0"/>
                <TextBlock Text="Authorised Signatory" FontSize="11" Foreground="#536176"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>

        </Grid>

      </Grid><!-- end root Grid -->
    </ScrollViewer>
  </DockPanel>
</UserControl>
