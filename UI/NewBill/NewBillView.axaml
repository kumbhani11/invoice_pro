<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.NewBill"
             x:DataType="vm:NewBillViewModel"
             x:Class="InvoicePro.UI.NewBill.NewBillView">


<UserControl.Styles>

    <!-- Typography scale for NewBillView (inherits Arial from App.axaml WinFontUI):
         Invoice title : 22px Bold
         Company name  : 18px Bold
         Section hdrs  : 13px SemiBold
         Field labels  : 12px Medium (FontWeight=Medium)
         Input values  : 12px Normal
         Table headers : 12px SemiBold
         Table content : 12px Normal
         Status bar    : 11px Normal
    -->

    <!-- Section border -->
    <!-- (sec, sec-hdr, hdr-lbl, lbl, inp, ComboBox.inp, btn-* all defined globally in App.axaml) -->

    <!-- Scoped only to the invoice items grid -->
    <Style Selector="DataGrid#ItemsGrid">
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#D5DDE7"/>
        <Setter Property="VerticalGridLinesBrush" Value="#D5DDE7"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="DataGrid#ItemsGrid DataGridColumnHeader">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="#C7D1DE"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style Selector="DataGrid#ItemsGrid DataGridRow:nth-child(even)">
        <Setter Property="Background" Value="#F7F9FC"/>
    </Style>
    <Style Selector="DataGrid#ItemsGrid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="#E5F0FF"/>
    </Style>

</UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="10,10,10,6" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="0,0,0,6">
        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
          <TextBlock Text="TAX INVOICE" FontSize="22" FontWeight="ExtraBold" Foreground="#17243B" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="Original for Recipient" FontSize="12" Foreground="#536176" HorizontalAlignment="Right" VerticalAlignment="Top"/>
      </Grid>


<!-- Row 1: Company Information + Invoice Details -->
<Grid Grid.Row="1"
      ColumnDefinitions="*,*"
      Margin="0,0,0,6"
      Height="100"
      MaxHeight="100">

    <!-- Company Information -->
    <Border Grid.Column="0"
            Classes="sec"
            Margin="0,0,3,0">
        <Grid RowDefinitions="24,*">
            <Border Grid.Row="0"
                    Classes="sec-hdr">
                <TextBlock Text="Company Information"
                           Classes="hdr-lbl"
                           VerticalAlignment="Center"/>
            </Border>

            <Grid Grid.Row="1"
                  Margin="9,2,9,2"
                  RowDefinitions="18,16,16,16"
                  ColumnDefinitions="*">

                <TextBlock Grid.Row="0"
                           Text="{Binding SelectedCompany.CompanyName}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#17243B"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Grid Grid.Row="1"
                      ColumnDefinitions="74,6,*">
                    <TextBlock Grid.Column="0"
                               Text="Regd. Office"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#000000"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text=":"
                               FontSize="11"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedCompany.AddressLine1}"
                               FontSize="11"
                               Foreground="#000000"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="74,6,*">
                    <TextBlock Grid.Column="0"
                               Text="Ph."
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#000000"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text=":"
                               FontSize="11"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedCompany.Contact}"
                               FontSize="11"
                               Foreground="#000000"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Grid.Row="3"
                      ColumnDefinitions="74,6,*">
                    <TextBlock Grid.Column="0"
                               Text="GSTIN"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#000000"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text=":"
                               FontSize="11"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedCompany.GSTIN}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#17243B"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <!-- Invoice Details -->
    <Border Grid.Column="1"
            Classes="sec"
            Margin="3,0,0,0">
        <Grid RowDefinitions="24,*">
            <Border Grid.Row="0"
                    Classes="sec-hdr">
                <TextBlock Text="Invoice Details"
                           Classes="hdr-lbl"
                           VerticalAlignment="Center"/>
            </Border>

            <Grid Grid.Row="1"
                  Margin="9,2,9,2"
                  RowDefinitions="18,18,18,18"
                  ColumnDefinitions="90,*">

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Invoice No."
                           FontSize="11"
                           FontWeight="ExtraBold"
                           Foreground="#000000"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Classes="inp"
                         Margin="8,0,0,0"
                         Height="18"
                         MinHeight="18"
                         FontSize="12"
                         Padding="6,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding InvoiceNumber, Mode=TwoWay}"
                         AutomationProperties.Name="Invoice Number"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Date"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#000000"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Classes="inp"
                         Margin="8,0,0,0"
                         Height="18"
                         MinHeight="18"
                         FontSize="12"
                         Padding="6,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding InvoiceDateString, Mode=TwoWay}"
                         AutomationProperties.Name="Invoice Date"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="State"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#000000"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Classes="inp"
                         Margin="8,0,0,0"
                         Height="18"
                         MinHeight="18"
                         FontSize="12"
                         Padding="6,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding InvoiceState, Mode=TwoWay}"
                         AutomationProperties.Name="Invoice State"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="State Code"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#000000"
                           VerticalAlignment="Center"
                           TextAlignment="Right"/>

                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Classes="inp"
                         Margin="8,0,0,0"
                         Height="18"
                         MinHeight="18"
                         Width="90"
                         HorizontalAlignment="Left"
                         FontSize="12"
                         Padding="6,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding InvoiceStateCode, Mode=TwoWay}"
                         AutomationProperties.Name="Invoice State Code"/>
            </Grid>
        </Grid>
    </Border>
</Grid>


<!-- Row 2: Borderless Bill To Party + Supply To Party -->
<Grid Grid.Row="2"
      ColumnDefinitions="*,12,*"
      Margin="0,0,0,6"
      Height="100"
      MinHeight="100"
      MaxHeight="100">

    <!-- Bill To Party -->
    <Grid Grid.Column="0"
          RowDefinitions="20,22,26,16,16">

        <!-- Heading -->
        <Border Grid.Row="0"
                Background="#E9EEF5"
                BorderBrush="#C7D1DE"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <TextBlock Text="Bill To Party"
                       Classes="hdr-lbl"
                       FontSize="13"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Customer -->
        <Grid Grid.Row="1"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*">
            <TextBlock Grid.Column="0"
                       Text="Customer"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <ComboBox Grid.Column="1"
                      Classes="inp"
                      Margin="6,0,0,0"
                      Height="22"
                      MinHeight="22"
                      FontSize="12"
                      Padding="6,0"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      IsTextSearchEnabled="True"
                      DisplayMemberBinding="{Binding CustomerName}"
                      AutomationProperties.Name="Bill To Customer"/>
        </Grid>

        <!-- Address -->
        <Grid Grid.Row="2"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*">
            <TextBlock Grid.Column="0"
                       Text="Address"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding BillToAddress}"
                       FontSize="12"
                       Foreground="#000000"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       Margin="6,0,0,0"/>
        </Grid>

        <!-- GSTIN -->
        <Grid Grid.Row="3"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*">
            <TextBlock Grid.Column="0"
                       Text="GSTIN"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding BillToGstin}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#17243B"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- State -->
        <Grid Grid.Row="4"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*,Auto,34">
            <TextBlock Grid.Column="0"
                       Text="State"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding BillToState}"
                       FontSize="12"
                       Foreground="#17243B"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="2"
                       Text="Code"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#64748B"
                       Margin="4,0,4,0"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="{Binding BillToStateCode}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#17243B"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>

    <!-- Subtle vertical divider -->
    <Border Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            Background="#D5DDE7"
            Margin="0,4"/>

    <!-- Supply To Party -->
    <Grid Grid.Column="2"
          RowDefinitions="20,22,26,16,16">

        <!-- Heading -->
        <Border Grid.Row="0"
                Background="#E9EEF5"
                BorderBrush="#C7D1DE"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <TextBlock Text="Supply To Party"
                       Classes="hdr-lbl"
                       FontSize="13"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Customer -->
        <Grid Grid.Row="1"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*">
            <TextBlock Grid.Column="0"
                       Text="Customer"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding SupplyToName}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#17243B"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Address -->
        <Grid Grid.Row="2"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*">
            <TextBlock Grid.Column="0"
                       Text="Address"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding SupplyToAddress}"
                       FontSize="12"
                       Foreground="#000000"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       Margin="6,0,0,0"/>
        </Grid>

        <!-- GSTIN -->
        <Grid Grid.Row="3"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*">
            <TextBlock Grid.Column="0"
                       Text="GSTIN"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding SupplyToGstin}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#17243B"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- State -->
        <Grid Grid.Row="4"
              Margin="8,0,8,0"
              ColumnDefinitions="66,*,Auto,34">
            <TextBlock Grid.Column="0"
                       Text="State"
                       Classes="lbl"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding SupplyToState}"
                       FontSize="12"
                       Foreground="#17243B"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="2"
                       Text="Code"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#64748B"
                       Margin="4,0,4,0"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="{Binding SupplyToStateCode}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#17243B"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Grid>


      <Grid Grid.Row="3" ColumnDefinitions="3*,1*" MinHeight="200" Margin="0,0,0,6">
        <Border Grid.Column="0" Classes="sec" Margin="0,0,3,0">
          <Grid RowDefinitions="28,*">

            <Border Grid.Row="0" Classes="sec-hdr">
              <Grid ColumnDefinitions="*,Auto,Auto"
                    Height="28"
                    VerticalAlignment="Center">

                <TextBlock Grid.Column="0"
                           Text="Product Details"
                           Classes="hdr-lbl"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Classes="btn-primary"
                        Command="{Binding AddRowCommand}"
                        Margin="0,0,6,0"
                        Padding="10,0"
                        Height="24"
                        MinHeight="24"
                        FontSize="11"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Content="+ Add Item"/>

                <Button Grid.Column="2"
                        Classes="btn-del"
                        Command="{Binding RemoveRowCommand}"
                        Width="24"
                        Height="24"
                        MinHeight="24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTip.Tip="Remove last row">
                  <Path Data="M9 3H15L16 5H19V7H5V5H8L9 3ZM7 9H17L16 19H8L7 9Z"
                        Fill="#D93025"
                        Stretch="Uniform"
                        Width="13"
                        Height="13"/>
                </Button>

              </Grid>
            </Border>


            <DataGrid Grid.Row="1" Name="ItemsGrid" ItemsSource="{Binding InvoiceItems}" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="200" MinColumnWidth="40">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="S.No" Width="56" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SNo}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Product Description" Width="2.5*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding ProductDescription}" Margin="4,0" FontSize="12" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding ProductDescription, Mode=TwoWay}" Margin="2" BorderThickness="0" FontSize="12"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="FIT" Width="0.9*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Fit}" HorizontalAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding Fit, Mode=TwoWay}" Margin="2" BorderThickness="0" FontSize="12"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="SIZE" Width="0.9*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Size}" HorizontalAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding Size, Mode=TwoWay}" Margin="2" BorderThickness="0" FontSize="12"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="HSN" Width="0.9*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Hsn}" HorizontalAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding Hsn, Mode=TwoWay}" Margin="2" BorderThickness="0" FontSize="12"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="QTY" Width="0.8*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Qty}" HorizontalAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding Qty, Mode=TwoWay}" Margin="2" BorderThickness="0" FontSize="12" HorizontalContentAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="UOM" Width="0.9*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Uom}" HorizontalAlignment="Center" FontSize="12" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <ComboBox SelectedItem="{Binding Uom, Mode=TwoWay}" Margin="1" Height="26" FontSize="12">
                        <ComboBoxItem>Pcs</ComboBoxItem>
                        <ComboBoxItem>Mtr</ComboBoxItem>
                        <ComboBoxItem>Kg</ComboBoxItem>
                        <ComboBoxItem>Box</ComboBoxItem>
                        <ComboBoxItem>Set</ComboBoxItem>
                      </ComboBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Rate (₹)" Width="1.1*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Rate, StringFormat={}{0:F2}}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding Rate, Mode=TwoWay}" Margin="2" BorderThickness="0" FontSize="12" HorizontalContentAlignment="Right"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Amount (₹)" Width="1.2*" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Amount, StringFormat={}{0:F2}}" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Classes="btn-del" Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Delete row">
                        <Path Data="M9 3H15L16 5H19V7H5V5H8L9 3ZM7 9H17L16 19H8L7 9Z" Fill="#D93025" Stretch="Uniform" Width="13" Height="13"/>
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="sec" Margin="3,0,0,0">
          <Grid RowDefinitions="26,Auto,26,Auto">
            <Border Grid.Row="0" Classes="sec-hdr">
              <TextBlock Text="Invoice Summary" Classes="hdr-lbl"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="10,8,10,6" Spacing="5">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Total Qty" FontSize="12" Foreground="#536176"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalQuantity}" FontSize="12" FontWeight="SemiBold" Foreground="#17243B"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Subtotal (₹)" FontSize="12" Foreground="#536176"/>
                <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat={}{0:F2}}" FontSize="12" Foreground="#17243B"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Discount" FontSize="12" Foreground="#536176" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Classes="inp" Width="80" Text="{Binding DiscountAmount, Mode=TwoWay, StringFormat={}{0:F2}}" HorizontalContentAlignment="Right" FontSize="12" AutomationProperties.Name="Discount Amount"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Taxable Amt (₹)" FontSize="12" Foreground="#536176"/>
                <TextBlock Grid.Column="1" Text="{Binding TaxableAmount, StringFormat={}{0:F2}}" FontSize="12" Foreground="#17243B"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding PreviewGstLabel}" FontSize="12" Foreground="#536176"/>
                <TextBlock Grid.Column="1" Text="{Binding TaxTotal, StringFormat={}{0:F2}}" FontSize="12" Foreground="#17243B"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Round Off" FontSize="12" Foreground="#536176"/>
                <TextBlock Grid.Column="1" Text="{Binding RoundOffAmount, StringFormat={}{0:F2}}" FontSize="12" Foreground="#17243B"/>
              </Grid>
              <Border Background="#E8F1FF" CornerRadius="3" Padding="8,5" Margin="0,2,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="NET AMOUNT (₹)" FontSize="12" FontWeight="Bold" Foreground="#17243B" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:F2}}" FontSize="18" FontWeight="Bold" Foreground="#17243B"/>
                </Grid>
              </Border>
            </StackPanel>
            <Border Grid.Row="2" Classes="sec-hdr">
              <TextBlock Text="GST Breakdown" Classes="hdr-lbl"/>
            </Border>
            <Grid Grid.Row="3" Margin="10,8,10,6" RowDefinitions="Auto,Auto,Auto,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="*,50,70">
                <TextBlock Grid.Column="0" Text="Tax Head" FontSize="11" FontWeight="Bold" Foreground="#536176"/>
                <TextBlock Grid.Column="1" Text="%" FontSize="11" FontWeight="Bold" Foreground="#536176" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Amount (₹)" FontSize="11" FontWeight="Bold" Foreground="#536176" HorizontalAlignment="Right"/>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,50,70" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="CGST" FontSize="12" Foreground="#17243B"/>
                <TextBlock Grid.Column="1" Text="{Binding PreviewCgstRate}" FontSize="12" Foreground="#17243B" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding CgstAmount, StringFormat={}{0:F2}}" FontSize="12" Foreground="#17243B" HorizontalAlignment="Right"/>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,50,70" Margin="0,3,0,0">
                <TextBlock Grid.Column="0" Text="SGST" FontSize="12" Foreground="#17243B"/>
                <TextBlock Grid.Column="1" Text="{Binding PreviewSgstRate}" FontSize="12" Foreground="#17243B" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding SgstAmount, StringFormat={}{0:F2}}" FontSize="12" Foreground="#17243B" HorizontalAlignment="Right"/>
              </Grid>
              <Grid Grid.Row="3" ColumnDefinitions="*,50,70" Margin="0,3,0,0">
                <TextBlock Grid.Column="0" Text="IGST" FontSize="12" Foreground="#17243B"/>
                <TextBlock Grid.Column="1" Text="{Binding PreviewIgstRate}" FontSize="12" Foreground="#17243B" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding PreviewIgstAmount}" FontSize="12" Foreground="#17243B" HorizontalAlignment="Right"/>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="4" Classes="sec" Margin="0,0,0,6">
        <Grid ColumnDefinitions="Auto,*" Margin="10,5">
          <TextBlock Grid.Column="0" Text="Rupees in words :" FontSize="12" FontWeight="Bold" Foreground="#17243B" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" Classes="inp" IsReadOnly="True" Text="{Binding PreviewAmountInWords}" Background="#F7F9FC" BorderThickness="0" AutomationProperties.Name="Amount in Words"/>
        </Grid>
      </Border>

      <Border Grid.Row="6" Background="#FFFFFF" BorderBrush="#CBD3DF" BorderThickness="1,1,0,0" Padding="10,0" Height="34">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Text="Ready" FontSize="12" Foreground="#536176" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="1" Text="{Binding CompanyName}" FontSize="12" FontWeight="Bold" Foreground="#17243B" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Grid.Column="2" Content="Switch" Height="22" Padding="10,0" FontSize="11" Command="{Binding SwitchCompanyCommand}" AutomationProperties.Name="Switch Company" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="3" Text="Printing automatically saves the invoice." FontSize="11" Foreground="#536176" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Grid.Column="4" Classes="btn-print" Command="{Binding PrintCommand}" IsEnabled="{Binding !IsPrinting}" AutomationProperties.Name="Print Invoice">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Data="M6 2H18V6H6V2ZM4 7H20A2 2 0 0 1 22 9V15H18V18H6V15H2V9A2 2 0 0 1 4 7ZM6 12H18V15H6V12ZM8 19V21H16V19H8Z" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform"/>
              <TextBlock Text="Print" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
