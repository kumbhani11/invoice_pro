<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.NewBill"
             x:DataType="vm:NewBillViewModel"
             x:Class="InvoicePro.UI.NewBill.NewBillView">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.invoice-input">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="ComboBox.invoice-combo">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="Button.invoice-action">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid IsVisible="{Binding !IsPreviewVisible}" Margin="10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border MaxWidth="1400" BorderBrush="#111827" BorderThickness="1" Background="#FBFAF6" Padding="12">
                    <StackPanel Spacing="10">

                        <Grid ColumnDefinitions="*,Auto,*">
                            <Border Grid.Column="0"/>
                            <TextBlock Grid.Column="1" Text="TAX INVOICE" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Original for Recipient" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, 310">
                            <Border BorderBrush="#111827" BorderThickness="1" Padding="8" Background="#FFFDFB">
                                <Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding CompanyName}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CompanyAddress1, StringFormat='Regd. Office: {0}'}" FontSize="10.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CompanyAddress2, StringFormat='Sales Office: {0}'}" FontSize="10.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CompanyPhone, StringFormat='Ph.: {0}'}" FontSize="10.5"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="GSTIN:" FontWeight="Bold" FontSize="10.5"/>
                                            <TextBlock Text="{Binding CompanyGstin}" FontWeight="Bold" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#111827" BorderThickness="1" Padding="8" Background="#FFFDFB">
                                <Grid>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="86,*" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0" Text="INVOICE NO." Classes="field-label"/>
                                            <TextBox Grid.Column="1" Text="{Binding InvoiceNumber, Mode=TwoWay}" Classes="invoice-input" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="86,*" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0" Text="DATE" Classes="field-label"/>
                                            <TextBox Grid.Column="1" Text="{Binding InvoiceDateString, Mode=TwoWay}" Classes="invoice-input" Width="150" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                                        </Grid>

                                        <Grid Grid.Row="2" ColumnDefinitions="86,*" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0" Text="STATE" Classes="field-label"/>
                                            <TextBox Grid.Column="1" Text="{Binding InvoiceState, Mode=TwoWay}" Classes="invoice-input" Width="170" Margin="4,0,0,0"/>
                                        </Grid>

                                        <Grid Grid.Row="3" ColumnDefinitions="86,*">
                                            <TextBlock Grid.Column="0" Text="STATE CODE" Classes="field-label"/>
                                            <TextBox Grid.Column="1" Text="{Binding InvoiceStateCode, Mode=TwoWay}" Classes="invoice-input" Width="82" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <Border Grid.Column="0" BorderBrush="#111827" BorderThickness="1" Padding="0" MinHeight="170" Margin="0,0,6,0">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#111827" BorderThickness="0,0,0,1" Padding="8,5">
                                        <TextBlock Text="BILL TO PARTY" Classes="section-title"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="8" Spacing="6">
                                        <Grid ColumnDefinitions="70,*">
                                            <TextBlock Grid.Column="0" Text="Customer" Classes="field-label" Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1" Classes="invoice-combo" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CustomerName}" FontSize="11"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <CheckBox IsChecked="{Binding UseSameCustomer}" Content="Use same customer for supply details" FontSize="10.5" Margin="0,0,0,2"/>

                                        <Grid Margin="0,2,0,0">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="Name" Classes="field-label"/>
                                                    <TextBox Grid.Column="1" Text="{Binding BillToName, Mode=TwoWay}" Classes="invoice-input"/>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="Address" Classes="field-label" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding BillToAddress, Mode=TwoWay}" Classes="invoice-input" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="30"/>
                                                </Grid>

                                                <Grid Grid.Row="2" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="GSTIN" Classes="field-label"/>
                                                    <TextBox Grid.Column="1" Text="{Binding BillToGstin, Mode=TwoWay}" Classes="invoice-input"/>
                                                </Grid>

                                                <Grid Grid.Row="3" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="State" Classes="field-label"/>
                                                    <TextBox Grid.Column="1" Text="{Binding BillToState, Mode=TwoWay}" Classes="invoice-input"/>
                                                </Grid>

                                                <Grid Grid.Row="4" ColumnDefinitions="72,*">
                                                    <TextBlock Grid.Column="0" Text="State Code" Classes="field-label"/>
                                                    <TextBox Grid.Column="1" Text="{Binding BillToStateCode, Mode=TwoWay}" Classes="invoice-input" Width="76" HorizontalAlignment="Left"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#111827" BorderThickness="1" Padding="0" MinHeight="170" Margin="6,0,0,0">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#111827" BorderThickness="0,0,0,1" Padding="8,5">
                                        <TextBlock Text="SUPPLY TO PARTY" Classes="section-title"/>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="8">
                                        <StackPanel IsVisible="{Binding UseSameCustomer}" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="Supply details are the same as Bill To." FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="Use the checkbox above to switch to a separate customer." FontSize="10.5" Foreground="#475569" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding !UseSameCustomer}" Spacing="6">
                                            <Grid ColumnDefinitions="70,*">
                                                <TextBlock Grid.Column="0" Text="Customer" Classes="field-label" Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1" Classes="invoice-combo" ItemsSource="{Binding Customers}" SelectedItem="{Binding SupplyToCustomer}" HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding CustomerName}" FontSize="11"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <Grid Margin="0,2,0,0">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                        <TextBlock Grid.Column="0" Text="Name" Classes="field-label"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SupplyToName, Mode=TwoWay}" Classes="invoice-input"/>
                                                    </Grid>

                                                    <Grid Grid.Row="1" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                        <TextBlock Grid.Column="0" Text="Address" Classes="field-label" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SupplyToAddress, Mode=TwoWay}" Classes="invoice-input" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="30"/>
                                                    </Grid>

                                                    <Grid Grid.Row="2" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                        <TextBlock Grid.Column="0" Text="GSTIN" Classes="field-label"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SupplyToGstin, Mode=TwoWay}" Classes="invoice-input"/>
                                                    </Grid>

                                                    <Grid Grid.Row="3" ColumnDefinitions="72,*" Margin="0,0,0,6">
                                                        <TextBlock Grid.Column="0" Text="State" Classes="field-label"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SupplyToState, Mode=TwoWay}" Classes="invoice-input"/>
                                                    </Grid>

                                                    <Grid Grid.Row="4" ColumnDefinitions="72,*">
                                                        <TextBlock Grid.Column="0" Text="State Code" Classes="field-label"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SupplyToStateCode, Mode=TwoWay}" Classes="invoice-input" Width="76" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border BorderBrush="#111827" BorderThickness="1" Background="#FFFDFB">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#111827" BorderThickness="0,0,0,1" Padding="8,5">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="PRODUCT DETAILS" Classes="section-title" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="+ Add Item" Command="{Binding AddRowCommand}" Classes="invoice-action" Margin="4,0,0,0" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
                                    </Grid>
                                </Border>

                                <DataGrid Grid.Row="1" Name="ItemsGrid" ItemsSource="{Binding InvoiceItems}" AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0" Height="430" MinHeight="340" Margin="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#111827" VerticalGridLinesBrush="#111827" CanUserResizeColumns="True" RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="S. No" Binding="{Binding SNo}" Width="55" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Product Description" Width="2.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProductDescription}" Margin="4,2" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding ProductDescription, Mode=TwoWay}" Margin="2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="FIT" Binding="{Binding Fit}" Width="75"/>
                                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="75"/>
                                        <DataGridTextColumn Header="HSN" Binding="{Binding Hsn}" Width="85"/>
                                        <DataGridTemplateColumn Header="QTY" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Qty}" Margin="4,2" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Qty, Mode=TwoWay}" Margin="2" HorizontalContentAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="UOM" Binding="{Binding Uom}" Width="70"/>
                                        <DataGridTemplateColumn Header="RATE" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Rate, StringFormat='{}{0:C}'}" Margin="4,2" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Rate, Mode=TwoWay}" Margin="2" HorizontalContentAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="AMOUNT" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:C}'}" Margin="4,2" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,290">
                            <Border Grid.Column="0" BorderBrush="#111827" BorderThickness="1" Padding="8" Margin="0,0,12,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="AMOUNT IN WORDS" Classes="section-title"/>
                                    <TextBlock Text="{Binding PreviewAmountInWords}" FontStyle="Italic" TextWrapping="Wrap" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#111827" BorderThickness="1" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                <TextBlock Grid.Column="0" Text="Subtotal" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                <TextBlock Grid.Column="0" Text="Discount" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                <TextBlock Grid.Column="0" Text="Taxable Amount" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TaxableAmount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                <TextBlock Grid.Column="0" Text="CGST" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CgstAmount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                <TextBlock Grid.Column="0" Text="SGST" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SgstAmount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                            <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Round Off" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RoundOffAmount, StringFormat='{}{0:C}'}" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <Border BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Margin="0,4"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="NET AMOUNT" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat='{}{0:C}'}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button Content="Preview" Click="PreviewButton_Click" Classes="invoice-action" Width="120"/>
                                <Button Content="Save Invoice" Command="{Binding SaveInvoiceCommand}" Classes="invoice-action" Width="150" Background="#16A34A" Foreground="White" BorderBrush="#16A34A"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border IsVisible="{Binding IsPreviewVisible}" Background="#F3F4F6" Padding="12">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Invoice Preview" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Back to Edit" Padding="18,8" Click="PreviewButton_Click"/>
                </Grid>
                <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="16" HorizontalAlignment="Center">
                    <ScrollViewer MaxWidth="820" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
