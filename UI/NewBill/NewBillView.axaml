<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.NewBill"
             x:DataType="vm:NewBillViewModel"
             x:Class="InvoicePro.UI.NewBill.NewBillView">

    <ScrollViewer>
        <StackPanel Margin="10" Spacing="10">
            
            <!-- 4-BOX HEADER SECTION -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                
                <!-- BOX 1: TOP LEFT (Prefilled Company Info) -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1,1,1,1" Padding="5">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding CompanyName}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding CompanyAddress1, StringFormat='Regd.Off: {0}'}" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="{Binding CompanyAddress2, StringFormat='Sales Office: {0}'}" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="{Binding CompanyPhone, StringFormat='Ph. {0}'}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="GSTIN:" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding CompanyGstin}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- BOX 2: TOP RIGHT (Invoice Details) -->
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="INVOICE NO.:" FontWeight="Bold" Padding="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceNumber}" FontWeight="Bold" FontSize="14" TextAlignment="Right" Padding="0,2"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DATE" FontWeight="Bold" Padding="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InvoiceDate, StringFormat=': {0:dd/MM/yyyy}'}" FontWeight="Bold" TextAlignment="Right" Padding="0,2"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="State" FontWeight="Bold" Padding="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvoiceState, StringFormat=': {0}'}" FontWeight="Bold" TextAlignment="Right" Padding="0,2"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="State Code" FontWeight="Bold" Padding="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InvoiceStateCode, StringFormat=': {0}'}" FontWeight="Bold" TextAlignment="Right" Padding="0,2"/>
                    </Grid>
                </Border>

                <!-- BOX 3: BOTTOM LEFT (Bill To & Customer Selection) -->
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,1" Padding="5">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bill to party: " VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Width="250" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding SelectedCustomer.Address}" TextWrapping="Wrap" Margin="10,5,0,15" MinHeight="35"/>
                        
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="GSTIN"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCustomer.Gstin, StringFormat=' : {0}'}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="State"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomer.State, StringFormat=' : {0}'}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="State Code: " Margin="10,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCustomer.StateCode}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BOX 4: BOTTOM RIGHT (Supply To - Auto-fills) -->
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Supply to party: " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCustomer.Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding SelectedCustomer.Address}" TextWrapping="Wrap" Margin="10,5,0,15" MinHeight="35"/>
                        
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="GSTIN"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCustomer.Gstin, StringFormat=' : {0}'}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="State"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomer.State, StringFormat=' : {0}'}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="State Code: " Margin="10,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCustomer.StateCode}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- PRODUCT DETAILS / ITEMS SECTION -->
            <Border BorderBrush="Black" BorderThickness="1,0,1,1" Padding="5">
                <StackPanel Spacing="5">
                    <TextBlock Text="Product Details" FontWeight="Bold"/>
                    
                    <!-- Items DataGrid or List -->
                    <DataGrid ItemsSource="{Binding InvoiceItems}" AutoGenerateColumns="False" IsReadOnly="False" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Description" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="FIT" Binding="{Binding Fit}" Width="80"/>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="80"/>
                            <DataGridTextColumn Header="HSN" Binding="{Binding Hsn}" Width="80"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="UOM" Binding="{Binding Uom}" Width="60"/>
                            <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="80"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <Button Content="Add Item" Command="{Binding AddItemCommand}"/>
                </StackPanel>
            </Border>

            <!-- TOTALS & ACTIONS SECTION -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding AmountInWords, StringFormat='Rupees in words: {0}'}" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" Width="250">
                    <TextBlock Text="{Binding TotalAmount, StringFormat='Total Amount: {0:C}'}" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <Button Content="Save &amp; Preview Invoice" Command="{Binding SaveInvoiceCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>