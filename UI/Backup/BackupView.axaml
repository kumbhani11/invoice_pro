<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Backup"
             x:DataType="vm:BackupViewModel"
             x:Class="InvoicePro.UI.Backup.BackupView"
             Background="{StaticResource WinBg}">

    <Grid RowDefinitions="Auto, *">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="💾 Backup Database"  Click="OnBackupClicked"  Classes="Primary"/>
                <Button Content="📂 Restore Database" Click="OnRestoreClicked" Classes="Danger"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource WinBorderLight}"
                    BorderThickness="1" Padding="16" Width="480" HorizontalAlignment="Left">
                <StackPanel Spacing="12">
                    <TextBlock Text="Protect your data by regularly backing up your database."
                               FontSize="12" Foreground="{StaticResource WinMuted}"/>

                    <Rectangle Height="1" Fill="{StaticResource WinBorderLight}"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Backup" FontWeight="SemiBold"/>
                        <TextBlock Text="Creates a copy of your billing data to a location you choose."
                                   FontSize="11" Foreground="{StaticResource WinMuted}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Restore" FontWeight="SemiBold"/>
                        <TextBlock Text="WARNING: Restoring will overwrite all current data. Restart the app afterwards."
                                   FontSize="11" Foreground="{StaticResource WinDanger}"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
