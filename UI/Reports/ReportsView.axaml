<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvoicePro.UI.Reports"
             x:DataType="vm:ReportsViewModel"
             x:Class="InvoicePro.UI.Reports.ReportsView"
             Background="{StaticResource WinBg}">

    <Grid RowDefinitions="Auto, *">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="From:" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding StartDate}" Height="24" CornerRadius="0"/>
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <DatePicker SelectedDate="{Binding EndDate}"   Height="24" CornerRadius="0"/>
                <Button Content="Generate Report" Command="{Binding GenerateReportCommand}" Classes="Primary"/>
            </StackPanel>
        </Border>

        <!-- Results -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource WinBorderLight}"
                    BorderThickness="1" Padding="16" Width="440" HorizontalAlignment="Left">
                <Grid RowDefinitions="28,28,28,1,32" ColumnDefinitions="200,*">

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Valid Bills:"    VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalBills}"  VerticalAlignment="Center"
                               FontFamily="{StaticResource WinFontMono}" FontWeight="Bold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Gross Amount:"  VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalGross, StringFormat='₹ {0:N2}'}"
                               FontFamily="{StaticResource WinFontMono}" FontWeight="Bold" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Tax Collected:" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalTax, StringFormat='₹ {0:N2}'}"
                               FontFamily="{StaticResource WinFontMono}" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Rectangle Grid.Row="3" Grid.ColumnSpan="2" Fill="#C0C0C0"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Total Net Sales:"
                               FontWeight="Bold" Foreground="{StaticResource WinSuccess}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalNet, StringFormat='₹ {0:N2}'}"
                               FontFamily="{StaticResource WinFontMono}" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource WinSuccess}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
