<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InvoicePro.ViewModels"
        x:Class="InvoicePro.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="InvoicePro - Commercial Billing System"
        Width="1100" Height="700"
        Background="{StaticResource WinBg}"
        FontFamily="{StaticResource WinFontUI}">

    <DockPanel LastChildFill="True">
        
        <!-- 1. Top Native MenuBar -->
        <Menu DockPanel.Dock="Top" Height="22" Background="{StaticResource WinBg}" BorderBrush="{StaticResource WinBorderLight}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New Invoice" HotKey="Ctrl+N" Command="{Binding NavigateCommand}" CommandParameter="NewBill"/>
                <Separator/>
                <MenuItem Header="_Backup Database..." Command="{Binding NavigateCommand}" CommandParameter="Backup"/>
                <Separator/>
                <MenuItem Header="E_xit"/>
            </MenuItem>
            <MenuItem Header="_Invoices">
                <MenuItem Header="_All Invoices" Command="{Binding NavigateCommand}" CommandParameter="Bills"/>
                <MenuItem Header="_Create Invoice" Command="{Binding NavigateCommand}" CommandParameter="NewBill"/>
            </MenuItem>
            <MenuItem Header="_Customers" Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
            <MenuItem Header="_Products" Command="{Binding NavigateCommand}" CommandParameter="Products"/>
            <MenuItem Header="_Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
            <MenuItem Header="_Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            <MenuItem Header="_Help">
                <MenuItem Header="_About InvoicePro"/>
            </MenuItem>
        </Menu>

        <!-- 2. ToolBar (16x16 / 20x20 icons with subtle dividers) -->
        <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource WinPanel}" BorderBrush="{StaticResource WinBorderLight}" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="toolbar" ToolTip.Tip="New Invoice (Ctrl+N)" Command="{Binding NavigateCommand}" CommandParameter="NewBill">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14" Stretch="Uniform" Fill="#333333"/>
                </Button>
                <Button Classes="toolbar" ToolTip.Tip="Save Document">
                    <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Width="14" Height="14" Stretch="Uniform" Fill="#333333"/>
                </Button>
                <Button Classes="toolbar" ToolTip.Tip="Print Preview">
                    <Path Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z" Width="14" Height="14" Stretch="Uniform" Fill="#333333"/>
                </Button>

                <!-- Vertical Toolbar Divider -->
                <Rectangle Width="1" Margin="4,2" Fill="{StaticResource WinBorderLight}"/>

                <Button Classes="toolbar" ToolTip.Tip="Refresh Data">
                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="14" Height="14" Stretch="Uniform" Fill="#333333"/>
                </Button>
                <Button Classes="toolbar" ToolTip.Tip="Search Database">
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Width="14" Height="14" Stretch="Uniform" Fill="#333333"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 3. Bottom Multi-Panel Status Bar -->
        <Border DockPanel.Dock="Bottom" Height="22" Background="{StaticResource WinBg}" BorderBrush="{StaticResource WinBorderLight}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, 120, 90, 140" Margin="4,0">
                <TextBlock Grid.Column="0" Text="Ready" VerticalAlignment="Center" FontSize="11" Foreground="#333333"/>
                <Border Grid.Column="1" BorderBrush="{StaticResource WinBorderLight}" BorderThickness="1,0,0,0" Padding="6,0">
                    <TextBlock Text="Invoices: 1,420" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource WinBorderLight}" BorderThickness="1,0,0,0" Padding="6,0">
                    <TextBlock Text="CUR: USD ($)" VerticalAlignment="Center" FontSize="11"/>
                </Border>
                <Border Grid.Column="3" BorderBrush="{StaticResource WinBorderLight}" BorderThickness="1,0,0,0" Padding="6,0">
                    <TextBlock Text="SQLITE: Connected" VerticalAlignment="Center" FontSize="11" Foreground="#006600"/>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Tab Strip & View Work Area -->
        <Border Background="{StaticResource WinBg}" Padding="3,3,3,0">
            <TabControl SelectedIndex="{Binding SelectedNavigationIndex}">
                <TabItem Header="Dashboard">
                    <ContentControl Content="{Binding CurrentDashboardView}" Margin="0,3,0,0"/>
                </TabItem>
                <TabItem Header="Invoices">
                    <ContentControl Content="{Binding CurrentBillsView}" Margin="0,3,0,0"/>
                </TabItem>
                <TabItem Header="New Bill">
                    <ContentControl Content="{Binding CurrentNewBillView}" Margin="0,3,0,0"/>
                </TabItem>
                <TabItem Header="Customers">
                    <ContentControl Content="{Binding CurrentCustomersView}" Margin="0,3,0,0"/>
                </TabItem>
                <TabItem Header="Products">
                    <ContentControl Content="{Binding CurrentProductsView}" Margin="0,3,0,0"/>
                </TabItem>
                <TabItem Header="Reports">
                    <ContentControl Content="{Binding CurrentReportsView}" Margin="0,3,0,0"/>
                </TabItem>
                <TabItem Header="Settings">
                    <ContentControl Content="{Binding CurrentSettingsView}" Margin="0,3,0,0"/>
                </TabItem>
            </TabControl>
        </Border>

    </DockPanel>
</Window>