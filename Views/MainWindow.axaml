<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InvoicePro.ViewModels"
        x:Class="InvoicePro.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="InvoicePro — Commercial Billing System"
        Width="1200" Height="740"
        MinWidth="900" MinHeight="560"
        Background="{StaticResource WinBg}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ═══ TAB BAR ═══ -->
        <Border Grid.Row="0" Background="#E4E4E4"
                BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="4,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="0">
                <Border Classes="tab" Classes.tabActive="{Binding IsNewBillActive}">
                    <Button Classes="tabBtn" Content="New Invoice" Command="{Binding NewBillCommand}"/>
                </Border>
                <Border Classes="tab" Classes.tabActive="{Binding IsBillsActive}">
                    <Button Classes="tabBtn" Content="All Invoices" Command="{Binding AllBillsCommand}"/>
                </Border>
                <Border Classes="tab" Classes.tabActive="{Binding IsCustomersActive}">
                    <Button Classes="tabBtn" Content="Customers" Command="{Binding CustomersCommand}"/>
                </Border>
                <Border Classes="tab" Classes.tabActive="{Binding IsProductsActive}">
                    <Button Classes="tabBtn" Content="Products" Command="{Binding ProductsCommand}"/>
                </Border>
                <Border Classes="tab" Classes.tabActive="{Binding IsReportsActive}">
                    <Button Classes="tabBtn" Content="Reports" Command="{Binding ReportsCommand}"/>
                </Border>
                <Border Classes="tab" Classes.tabActive="{Binding IsCompanyActive}">
                    <Button Classes="tabBtn" Content="Company" Command="{Binding CompanyCommand}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>

        <!-- Shell status bar hidden when NewBill is active (view has its own complete bar) -->
        <Border Grid.Row="2" Background="#F0F0F0"
                BorderBrush="#C0C0C0" BorderThickness="0,1,0,0"
                Padding="0"
                IsVisible="{Binding !IsNewBillActive}">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <Border Grid.Column="0" BorderBrush="#C0C0C0" BorderThickness="0,0,1,0" Padding="6,2">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="1" BorderBrush="#C0C0C0" BorderThickness="0,0,1,0" Padding="10,2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding CompanyName}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Switch" Command="{Binding SwitchCompanyCommand}" Width="64" Height="20"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="10,2">
                    <TextBlock Text="{Binding InvoiceCountText}" FontSize="11" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
